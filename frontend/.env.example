# Copy to .env.local and restart npm run dev.
# Server-only keys: never prefix these with VITE_.
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# data.go.kr: decoded key for VilageFcstInfoService_2.0 (not API Hub authKey)
KMA_SERVICE_KEY=your_kma_service_key
# data.go.kr: decoded key for AirKorea station and real-time air-quality services
AIRKOREA_SERVICE_KEY=your_airkorea_service_key

VITE_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key
