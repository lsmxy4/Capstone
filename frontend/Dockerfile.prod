FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_KAKAO_JAVASCRIPT_KEY
ENV VITE_KAKAO_JAVASCRIPT_KEY=$VITE_KAKAO_JAVASCRIPT_KEY
RUN npm run build

FROM node:22-alpine AS api
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY frontend/server ./server
COPY frontend/package.json ./package.json
RUN node --experimental-strip-types -e "import('./server/uv.ts').then(m => { if (!m.uvArea(37.5665, 126.978).code) process.exit(1) })"
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--experimental-strip-types", "server/production.ts"]

FROM nginx:stable-alpine AS web
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
